# ADR: docs/adr/ADR-0010-http-server-performance-measurement.md
# Exercises the real-socket benchmark CLI and its independently checked wires.
execute_process(COMMAND "${BENCHMARK}" --quick RESULT_VARIABLE status
                OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic TIMEOUT 45)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "server benchmark failed: ${status}: ${diagnostic}")
endif()
string(JSON count LENGTH "${report}" cases)
if(NOT count EQUAL 8)
    message(FATAL_ERROR "server benchmark must report all eight scenarios")
endif()
foreach(index RANGE 7)
    foreach(field IN ITEMS server_process_cpu_seconds server_thread_cpu_seconds
                           server_peak_rss_bytes client_pid server_pid)
        string(JSON value ERROR_VARIABLE missing GET "${report}" cases ${index} ${field})
        if(missing OR NOT value GREATER 0)
            message(FATAL_ERROR "isolated server measurement missing: ${field}")
        endif()
    endforeach()
    string(JSON client_pid GET "${report}" cases ${index} client_pid)
    string(JSON server_pid GET "${report}" cases ${index} server_pid)
    if(client_pid EQUAL server_pid)
        message(FATAL_ERROR "client and server must run in distinct processes")
    endif()
    foreach(field IN ITEMS requests requests_per_second p50_us p95_us p99_us elapsed_seconds
                           client_process_cpu_seconds client_peak_rss_bytes)
        string(JSON value GET "${report}" cases ${index} ${field})
        if(NOT value GREATER 0)
            message(FATAL_ERROR "${field} must be positive")
        endif()
    endforeach()
    string(JSON errors GET "${report}" cases ${index} errors)
    if(NOT errors EQUAL 0)
        message(FATAL_ERROR "socket or response validation failed")
    endif()
    # SB-6: whole server-process event counts are exact non-negative integers.
    foreach(field IN ITEMS server_unix_syscalls server_context_switches)
        string(JSON value ERROR_VARIABLE missing GET "${report}" cases ${index} ${field})
        if(missing OR NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "server event count missing or not an integer: ${field}")
        endif()
    endforeach()
    string(JSON p50 GET "${report}" cases ${index} p50_us)
    string(JSON p95 GET "${report}" cases ${index} p95_us)
    string(JSON p99 GET "${report}" cases ${index} p99_us)
    if(p50 GREATER p95 OR p95 GREATER p99)
        message(FATAL_ERROR "completion percentiles must be ordered")
    endif()
endforeach()
set(expected_cases health_c1 health_c8 health_c64 health_idle64 health_pipeline16
                   echo_1k_c1 echo_1k_c8 echo_1m_c1)
foreach(index RANGE 7)
    list(GET expected_cases ${index} expected_name)
    string(JSON actual_name GET "${report}" cases ${index} name)
    if(NOT actual_name STREQUAL expected_name)
        message(FATAL_ERROR "scenario identity disagrees with SB-2")
    endif()
endforeach()
# SB-6: each unpipelined health request needs at least one server receive and
# one server send, so health_c1 counts at least two Unix system calls per
# request; a client-side or zero counter fails. Depth-16 pipelining amortizes
# those calls, so its per-request count (cross-multiplied in integers) is lower.
string(JSON c1_requests GET "${report}" cases 0 requests)
string(JSON c1_syscalls GET "${report}" cases 0 server_unix_syscalls)
string(JSON pipeline_requests GET "${report}" cases 4 requests)
string(JSON pipeline_syscalls GET "${report}" cases 4 server_unix_syscalls)
math(EXPR c1_floor "2 * ${c1_requests}")
if(c1_syscalls LESS c1_floor)
    message(FATAL_ERROR "health_c1 server_unix_syscalls below two per request")
endif()
math(EXPR pipeline_scaled "${pipeline_syscalls} * ${c1_requests}")
math(EXPR c1_scaled "${c1_syscalls} * ${pipeline_requests}")
if(NOT pipeline_scaled LESS c1_scaled)
    message(FATAL_ERROR "pipelined server system calls per request must be below health_c1")
endif()
foreach(idle IN ITEMS 512 2048)
    execute_process(COMMAND "${BENCHMARK}" --case "health_idle${idle}" --quick
                    RESULT_VARIABLE status OUTPUT_VARIABLE scale_report
                    ERROR_VARIABLE diagnostic TIMEOUT 20)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "idle scaling scenario unavailable: ${idle}: ${diagnostic}")
    endif()
    string(JSON actual_idle GET "${scale_report}" cases 0 idle_connections)
    string(JSON errors GET "${scale_report}" cases 0 errors)
    if(NOT actual_idle EQUAL idle OR NOT errors EQUAL 0)
        message(FATAL_ERROR "idle scaling fixture disagrees with its dimensions")
    endif()
endforeach()
foreach(argument IN ITEMS --unknown --duration-ms --case)
    execute_process(COMMAND "${BENCHMARK}" "${argument}" RESULT_VARIABLE status
                    OUTPUT_QUIET ERROR_QUIET)
    if(NOT status STREQUAL "2")
        message(FATAL_ERROR "invalid invocation must exit 2")
    endif()
endforeach()
# SB-7: optional multi-threaded client driving keeps the case contract: three
# threads still complete all eight scenarios with valid wires and report the
# thread count, while out-of-range counts exit 2 like malformed durations.
execute_process(COMMAND "${BENCHMARK}" --quick --client-threads 3 RESULT_VARIABLE status
                OUTPUT_VARIABLE threaded_report ERROR_VARIABLE diagnostic TIMEOUT 45)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "threaded client benchmark failed: ${status}: ${diagnostic}")
endif()
string(JSON threaded_count LENGTH "${threaded_report}" cases)
if(NOT threaded_count EQUAL 8)
    message(FATAL_ERROR "threaded client benchmark must report all eight scenarios")
endif()
string(JSON threaded_threads ERROR_VARIABLE threads_missing GET "${threaded_report}" cases 0
        client_threads)
if(threads_missing OR NOT threaded_threads EQUAL 3)
    message(FATAL_ERROR "threaded client benchmark must report its thread count")
endif()
string(JSON threaded_errors GET "${threaded_report}" cases 0 errors)
if(NOT threaded_errors EQUAL 0)
    message(FATAL_ERROR "threaded client validation failed")
endif()
foreach(value IN ITEMS 0 -1 9 nan 2.5)
    execute_process(COMMAND "${BENCHMARK}" --client-threads "${value}" RESULT_VARIABLE status
                    OUTPUT_QUIET ERROR_QUIET)
    if(NOT status STREQUAL "2")
        message(FATAL_ERROR "invalid client thread count must exit 2")
    endif()
endforeach()
foreach(value IN ITEMS 0 -1 10001 nan 0.5)
    execute_process(COMMAND "${BENCHMARK}" --duration-ms "${value}" RESULT_VARIABLE status
                    OUTPUT_QUIET ERROR_QUIET)
    if(NOT status STREQUAL "2")
        message(FATAL_ERROR "invalid duration must exit 2")
    endif()
endforeach()
execute_process(COMMAND "${BENCHMARK}" --case unknown RESULT_VARIABLE status
                OUTPUT_QUIET ERROR_QUIET)
if(NOT status STREQUAL "2")
    message(FATAL_ERROR "unknown scenario must exit 2")
endif()
