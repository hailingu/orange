@@ -0,0 +1,325 @@
+// ADR: docs/adr/ADR-0010-http-server-performance-measurement.md
+// Measures real loopback request completion with independent wire validation.
+// The single client loop multiplexes nonblocking sockets; the production loop
+// runs on a second thread. CPU and RSS therefore include both participants.
+#include "http_server.hpp"
+#include "routes.hpp"
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <charconv>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <iostream>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+using namespace std::chrono_literals;
+
+// Owns one client descriptor, including early validation-failure paths.
+struct Client {
+    int fd = -1;
+    std::size_t sent = 0;
+    std::size_t received = 0;
+    Clock::time_point started{};
+    bool done = false;
+    explicit Client(int socket) : fd(socket) {}
+    ~Client() {
+        if (fd >= 0)
+            ::close(fd);
+    }
+    Client(Client &&other) noexcept : fd(std::exchange(other.fd, -1)) {}
+    Client(const Client &) = delete;
+};
+
+// Stops and joins the real server even if a client operation throws.
+class Server {
+  public:
+    Server() {
+        if (const int error = loop_.bind(0, &port); error != 0)
+            throw std::runtime_error("server bind errno=" + std::to_string(error));
+        worker_ = std::thread(
+            [this] { result_ = loop_.serve(orange::http::handle_request, 30s, stop_); });
+    }
+    ~Server() { finish(); }
+    // Joins before examining the event loop's errno-style result.
+    int finish() {
+        stop_.store(true);
+        if (worker_.joinable())
+            worker_.join();
+        return result_;
+    }
+    std::uint16_t port = 0;
+
+  private:
+    orange::http::LoopbackServer loop_;
+    std::atomic_bool stop_{false};
+    std::thread worker_;
+    int result_ = -1;
+};
+
+// Scenario dimensions keep connection count, pipeline depth and body distinct.
+struct Scenario {
+    const char *name;
+    int active;
+    int idle;
+    int pipeline;
+    std::size_t body;
+};
+constexpr Scenario scenarios[] = {
+    {"health_c1", 1, 0, 1, 0},          {"health_c8", 8, 0, 1, 0},
+    {"health_c64", 64, 0, 1, 0},        {"health_idle64", 1, 64, 1, 0},
+    {"health_pipeline16", 1, 0, 16, 0}, {"echo_1k_c1", 1, 0, 1, 1024},
+    {"echo_1k_c8", 8, 0, 1, 1024},      {"echo_1m_c1", 1, 0, 1, 1048576}};
+
+// Constructs expected protocol bytes without calling the production serializer.
+std::pair<std::string, std::string> wires(const Scenario &scenario) {
+    if (scenario.body == 0)
+        return {"GET /api/health HTTP/1.1\r\nHost: localhost\r\n\r\n",
+                "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
+                "Content-Length: 15\r\n\r\n{\"status\":\"ok\"}"};
+    const std::string body(scenario.body, 'x');
+    const std::string hex = scenario.body == 1024 ? "400" : "100000";
+    return {"POST /api/echo HTTP/1.1\r\nHost: localhost\r\nContent-Length: " +
+                std::to_string(scenario.body) + "\r\n\r\n" + body,
+            "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" + hex + "\r\n" + body +
+                "\r\n0\r\n\r\n"};
+}
+
+// Connects with a bounded timeout and identical TCP options for every revision.
+Client connect_to(std::uint16_t port) {
+    Client client(::socket(AF_INET, SOCK_STREAM, 0));
+    if (client.fd < 0)
+        throw std::runtime_error("client socket failed");
+    const timeval timeout{2, 0};
+    const int on = 1;
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(port);
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (::setsockopt(client.fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) < 0 ||
+        ::setsockopt(client.fd, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on)) < 0 ||
+        ::setsockopt(client.fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on)) < 0 ||
+        ::connect(client.fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) < 0 ||
+        ::fcntl(client.fd, F_SETFL, O_NONBLOCK) < 0)
+        throw std::runtime_error("client setup errno=" + std::to_string(errno));
+    return client;
+}
+
+// Sends a window without blocking; all socket failures remain explicit.
+void send_window(Client &client, const std::string &request) {
+    while (client.sent < request.size()) {
+        if (client.sent == 0)
+            client.started = Clock::now();
+        const auto count =
+            ::send(client.fd, request.data() + client.sent, request.size() - client.sent, 0);
+        if (count > 0)
+            client.sent += static_cast<std::size_t>(count);
+        else if (count < 0 && errno == EINTR)
+            continue;
+        else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+            return;
+        else
+            throw std::runtime_error("client send failed");
+    }
+}
+
+// Validates each byte and records completion of each response in a window.
+void receive_window(Client &client, const std::string &response, int pipeline,
+                    std::vector<double> &latencies) {
+    const auto total = response.size() * static_cast<std::size_t>(pipeline);
+    while (client.received < total) {
+        char buffer[16384];
+        const auto count =
+            ::recv(client.fd, buffer, std::min(sizeof(buffer), total - client.received), 0);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+            return;
+        if (count <= 0)
+            throw std::runtime_error("client receive failed or unexpected EOF");
+        std::size_t offset = 0;
+        while (offset < static_cast<std::size_t>(count)) {
+            const auto at = client.received % response.size();
+            const auto length =
+                std::min(response.size() - at, static_cast<std::size_t>(count) - offset);
+            if (std::memcmp(buffer + offset, response.data() + at, length) != 0)
+                throw std::runtime_error("response wire mismatch");
+            offset += length;
+            client.received += length;
+            if (client.received % response.size() == 0)
+                latencies.push_back(
+                    std::chrono::duration<double, std::micro>(Clock::now() - client.started)
+                        .count());
+        }
+    }
+}
+
+// Measures a closed-loop load, then drains every issued request before returning.
+double exercise(std::vector<Client> &clients, const std::string &request,
+                const std::string &response, int pipeline, int duration_ms,
+                std::vector<double> &latencies) {
+    std::vector<pollfd> fds(clients.size());
+    const auto begin = Clock::now();
+    const auto end = begin + std::chrono::milliseconds(duration_ms);
+    std::size_t done = 0;
+    while (done < clients.size()) {
+        if (Clock::now() > end + 3s)
+            throw std::runtime_error("client deadline exceeded");
+        for (std::size_t i = 0; i < clients.size(); ++i) {
+            const auto &client = clients[i];
+            fds[i] = {client.fd,
+                      static_cast<short>(client.done                    ? 0
+                                         : client.sent < request.size() ? POLLOUT
+                                                                        : POLLIN),
+                      0};
+        }
+        if (::poll(fds.data(), fds.size(), 100) < 0) {
+            if (errno == EINTR)
+                continue;
+            throw std::runtime_error("client poll failed");
+        }
+        for (std::size_t i = 0; i < clients.size(); ++i) {
+            auto &client = clients[i];
+            if (client.done)
+                continue;
+            if (fds[i].revents & (POLLERR | POLLNVAL | POLLHUP))
+                throw std::runtime_error("client readiness error");
+            if (fds[i].revents & POLLOUT)
+                send_window(client, request);
+            if (fds[i].revents & POLLIN)
+                receive_window(client, response, pipeline, latencies);
+            if (client.received != response.size() * static_cast<std::size_t>(pipeline))
+                continue;
+            if (Clock::now() >= end) {
+                client.done = true;
+                ++done;
+            } else {
+                client.sent = 0;
+                client.received = 0;
+            }
+        }
+    }
+    return std::chrono::duration<double>(Clock::now() - begin).count();
+}
+
+// Converts process user+system CPU to seconds (client and server combined).
+double cpu_seconds(const rusage &usage) {
+    return usage.ru_utime.tv_sec + usage.ru_stime.tv_sec +
+           (usage.ru_utime.tv_usec + usage.ru_stime.tv_usec) / 1000000.0;
+}
+
+// Reports nearest-rank percentiles over validated individual response completions.
+double percentile(const std::vector<double> &samples, std::size_t percent) {
+    return samples[(samples.size() * percent + 99) / 100 - 1];
+}
+
+// Excludes connection setup, warmup and shutdown from timing and CPU deltas.
+void measure(const Scenario &scenario, int duration_ms) {
+    Server server;
+    std::vector<Client> idle;
+    for (int i = 0; i < scenario.idle; ++i)
+        idle.push_back(connect_to(server.port));
+    std::vector<Client> clients;
+    for (int i = 0; i < scenario.active; ++i)
+        clients.push_back(connect_to(server.port));
+    const auto [single_request, response] = wires(scenario);
+    std::string request;
+    for (int i = 0; i < scenario.pipeline; ++i)
+        request += single_request;
+    std::vector<double> latencies;
+    latencies.reserve(262144);
+    exercise(clients, request, response, scenario.pipeline, 20, latencies);
+    for (auto &client : clients) {
+        client.done = false;
+        client.sent = 0;
+        client.received = 0;
+    }
+    latencies.clear();
+    rusage before{}, after{};
+    if (::getrusage(RUSAGE_SELF, &before) != 0)
+        throw std::runtime_error("getrusage failed");
+    const double elapsed =
+        exercise(clients, request, response, scenario.pipeline, duration_ms, latencies);
+    if (::getrusage(RUSAGE_SELF, &after) != 0)
+        throw std::runtime_error("getrusage failed");
+    if (latencies.empty())
+        throw std::runtime_error("no completed requests");
+    std::sort(latencies.begin(), latencies.end());
+    std::cout << "{\"name\":\"" << scenario.name << "\",\"active_connections\":" << scenario.active
+              << ",\"idle_connections\":" << scenario.idle << ",\"pipeline\":" << scenario.pipeline
+              << ",\"body_bytes\":" << scenario.body << ",\"requests\":" << latencies.size()
+              << ",\"elapsed_seconds\":" << elapsed
+              << ",\"requests_per_second\":" << latencies.size() / elapsed
+              << ",\"p50_us\":" << percentile(latencies, 50)
+              << ",\"p95_us\":" << percentile(latencies, 95)
+              << ",\"p99_us\":" << percentile(latencies, 99)
+              << ",\"process_cpu_seconds\":" << cpu_seconds(after) - cpu_seconds(before)
+              << ",\"process_peak_rss_bytes\":" << after.ru_maxrss << ",\"errors\":0}";
+    if (server.finish() != 0)
+        throw std::runtime_error("server loop returned an error");
+}
+
+// Parses a bounded duration so malformed or unbounded invocations fail fast.
+bool duration(std::string_view value, int &result) {
+    const auto parsed = std::from_chars(value.data(), value.data() + value.size(), result);
+    return parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size() && result > 0 &&
+           result <= 10000;
+}
+} // namespace
+
+// The CLI exits 2 for invalid options and 1 for socket/wire/deadline failures.
+int main(int argc, char **argv) {
+    int duration_ms = 200;
+    std::string_view selected;
+    for (int i = 1; i < argc; ++i) {
+        const std::string_view argument = argv[i];
+        if (argument == "--quick")
+            duration_ms = 20;
+        else if (argument == "--duration-ms" && i + 1 < argc && duration(argv[i + 1], duration_ms))
+            ++i;
+        else if (argument == "--case" && i + 1 < argc)
+            selected = argv[++i];
+        else {
+            std::fprintf(stderr, "invalid server benchmark invocation\n");
+            return 2;
+        }
+    }
+    if (!selected.empty() &&
+        std::none_of(std::begin(scenarios), std::end(scenarios),
+                     [&](const auto &scenario) { return selected == scenario.name; }))
+        return 2;
+    try {
+        std::cout << "{\"compiler\":\"" << ORANGE_BENCH_COMPILER << "\",\"flags\":\""
+                  << ORANGE_BENCH_FLAGS << "\",\"architecture\":\"" << ORANGE_BENCH_ARCH
+                  << "\",\"cases\":[";
+        bool first = true;
+        for (const auto &scenario : scenarios) {
+            if (!selected.empty() && selected != scenario.name)
+                continue;
+            if (!first)
+                std::cout << ',';
+            first = false;
+            measure(scenario, duration_ms);
+        }
+        std::cout << "]}\n";
+    } catch (const std::exception &error) {
+        std::fprintf(stderr, "server benchmark failed: %s\n", error.what());
+        return 1;
+    }
+    return 0;
+}
diff --git a/service/bench/verify_server.cmake b/service/bench/verify_server.cmake
new file mode 100644
index 0000000..bfaf9c9
--- /dev/null
+++ b/service/bench/verify_server.cmake
@@ -0,0 +1,58 @@
+# ADR: docs/adr/ADR-0010-http-server-performance-measurement.md
+# Exercises the real-socket benchmark CLI and its independently checked wires.
+execute_process(COMMAND "${BENCHMARK}" --quick RESULT_VARIABLE status
+                OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic TIMEOUT 45)
+if(NOT status STREQUAL "0")
+    message(FATAL_ERROR "server benchmark failed: ${status}: ${diagnostic}")
+endif()
+string(JSON count LENGTH "${report}" cases)
+if(NOT count EQUAL 8)
+    message(FATAL_ERROR "server benchmark must report all eight scenarios")
+endif()
+foreach(index RANGE 7)
+    foreach(field IN ITEMS requests requests_per_second p50_us p95_us p99_us elapsed_seconds
+                           process_cpu_seconds process_peak_rss_bytes)
+        string(JSON value GET "${report}" cases ${index} ${field})
+        if(NOT value GREATER 0)
+            message(FATAL_ERROR "${field} must be positive")
+        endif()
+    endforeach()
+    string(JSON errors GET "${report}" cases ${index} errors)
+    if(NOT errors EQUAL 0)
+        message(FATAL_ERROR "socket or response validation failed")
+    endif()
+    string(JSON p50 GET "${report}" cases ${index} p50_us)
+    string(JSON p95 GET "${report}" cases ${index} p95_us)
+    string(JSON p99 GET "${report}" cases ${index} p99_us)
+    if(p50 GREATER p95 OR p95 GREATER p99)
+        message(FATAL_ERROR "completion percentiles must be ordered")
+    endif()
+endforeach()
+set(expected_cases health_c1 health_c8 health_c64 health_idle64 health_pipeline16
+                   echo_1k_c1 echo_1k_c8 echo_1m_c1)
+foreach(index RANGE 7)
+    list(GET expected_cases ${index} expected_name)
+    string(JSON actual_name GET "${report}" cases ${index} name)
+    if(NOT actual_name STREQUAL expected_name)
+        message(FATAL_ERROR "scenario identity disagrees with SB-2")
+    endif()
+endforeach()
+foreach(argument IN ITEMS --unknown --duration-ms --case)
+    execute_process(COMMAND "${BENCHMARK}" "${argument}" RESULT_VARIABLE status
+                    OUTPUT_QUIET ERROR_QUIET)
+    if(NOT status STREQUAL "2")
+        message(FATAL_ERROR "invalid invocation must exit 2")
+    endif()
+endforeach()
+foreach(value IN ITEMS 0 -1 10001 nan 0.5)
+    execute_process(COMMAND "${BENCHMARK}" --duration-ms "${value}" RESULT_VARIABLE status
+                    OUTPUT_QUIET ERROR_QUIET)
+    if(NOT status STREQUAL "2")
+        message(FATAL_ERROR "invalid duration must exit 2")
+    endif()
+endforeach()
+execute_process(COMMAND "${BENCHMARK}" --case unknown RESULT_VARIABLE status
+                OUTPUT_QUIET ERROR_QUIET)
+if(NOT status STREQUAL "2")
+    message(FATAL_ERROR "unknown scenario must exit 2")
+endif()
diff --git a/service/tests/http_server_input_tests.cpp b/service/tests/http_server_input_tests.cpp
new file mode 100644
index 0000000..f9e059c
--- /dev/null
+++ b/service/tests/http_server_input_tests.cpp
@@ -0,0 +1,98 @@
+// ADR: service/docs/adr/ADR-0008-kqueue-response-scheduling.md
+// KS-2: a fixed 1 MiB body must reach the handler without a separate
+// 8–64 KiB input-staging allocation. Counting is local to the server thread;
+// body storage and the small owned head remain part of normal decoding.
+#include "http_server.hpp"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <netinet/in.h>
+#include <new>
+#include <string>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+
+namespace {
+thread_local bool counting = false;
+thread_local unsigned staging_allocations = 0;
+} // namespace
+
+// Counts the declared staging-size band without changing allocation semantics.
+void *operator new(std::size_t size) {
+    if (counting && size >= 8193 && size <= 65536)
+        ++staging_allocations;
+    if (void *memory = std::malloc(size == 0 ? 1 : size))
+        return memory;
+    throw std::bad_alloc{};
+}
+// Matches ordinary allocations used by standard-library request buffers.
+void operator delete(void *memory) noexcept { std::free(memory); }
+
+// Drives a fragmented body over real sockets and validates owned body bytes.
+int main() {
+    orange::http::LoopbackServer server;
+    std::uint16_t port = 0;
+    if (server.bind(0, &port) != 0)
+        return 1;
+    std::atomic_bool stop{false};
+    std::atomic_bool body_valid{false};
+    unsigned allocations = 0;
+    int result = -1;
+    std::thread worker([&] {
+        counting = true;
+        result = server.serve(
+            [&](const orange::http::ParsedMessage &message) {
+                body_valid.store(message.body.size() == 1048576 &&
+                                 std::all_of(message.body.begin(), message.body.end(),
+                                             [](char c) { return c == 'x'; }));
+                return orange::http::Response{
+                    200, orange::http::BodyFraming::content_length, "ok", {}, false};
+            },
+            std::chrono::seconds(5), stop);
+        counting = false;
+        allocations = staging_allocations;
+    });
+    const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(port);
+    const timeval timeout{2, 0};
+    const int on = 1;
+    bool pass = fd >= 0 &&
+                ::setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) == 0 &&
+                ::setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) == 0 &&
+                ::setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on)) == 0 &&
+                ::connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0;
+    const std::string request =
+        "POST / HTTP/1.1\r\nContent-Length: 1048576\r\n\r\n" + std::string(1048576, 'x');
+    std::size_t sent = 0;
+    while (pass && sent < request.size()) {
+        const auto count = ::send(fd, request.data() + sent,
+                                  std::min<std::size_t>(16384, request.size() - sent), 0);
+        if (count <= 0)
+            pass = false;
+        else
+            sent += static_cast<std::size_t>(count);
+    }
+    const std::string expected = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";
+    std::string received;
+    while (pass && received.size() < expected.size()) {
+        char bytes[128];
+        const auto count = ::recv(fd, bytes, sizeof(bytes), 0);
+        if (count <= 0)
+            pass = false;
+        else
+            received.append(bytes, static_cast<std::size_t>(count));
+    }
+    ::close(fd);
+    stop.store(true);
+    worker.join();
+    std::printf("KS-2: staging_band_allocations=%u body=%s\n", allocations,
+                body_valid.load() ? "Pass" : "Fail");
+    return pass && received == expected && body_valid.load() && result == 0 && allocations == 0 ? 0
+                                                                                                : 1;
+}
diff --git a/service/tests/http_server_scheduling_tests.cpp b/service/tests/http_server_scheduling_tests.cpp
new file mode 100644
index 0000000..b04deb9
--- /dev/null
+++ b/service/tests/http_server_scheduling_tests.cpp
@@ -0,0 +1,101 @@
+// ADR: service/docs/adr/ADR-0008-kqueue-response-scheduling.md
+// Interposes only to observe real kevent/send calls: sockets, readiness and
+// production dispatch still execute. KS-1 requires a newly queued response
+// to attempt delivery before another readiness wait on that connection.
+#include "http_server.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <dlfcn.h>
+#include <netinet/in.h>
+#include <string>
+#include <sys/event.h>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+
+namespace {
+thread_local unsigned waits = 0;
+thread_local unsigned queued_at = 0;
+thread_local bool pending = false;
+std::atomic_bool observed{false};
+std::atomic_bool immediate{false};
+
+// Resolves the system implementation, preserving every actual I/O side effect.
+template <class T> T system_call(const char *name) {
+    const auto symbol = ::dlsym(RTLD_NEXT, name);
+    if (!symbol)
+        std::abort();
+    return reinterpret_cast<T>(symbol);
+}
+} // namespace
+
+// Observes readiness boundaries without altering their arguments or results.
+extern "C" int kevent(int queue, const struct kevent *changes, int change_count,
+                      struct kevent *events, int capacity, const timespec *timeout) {
+    static const auto real = system_call<decltype(&::kevent)>("kevent");
+    ++waits;
+    return real(queue, changes, change_count, events, capacity, timeout);
+}
+
+// Observes the first actual send following the handler on the server thread.
+extern "C" ssize_t send(int fd, const void *buffer, size_t size, int flags) {
+    static const auto real = system_call<decltype(&::send)>("send");
+    if (pending) {
+        immediate.store(waits == queued_at);
+        observed.store(true);
+        pending = false;
+    }
+    return real(fd, buffer, size, flags);
+}
+
+// Uses a real client so a scheduling regression is tied to delivered wire bytes.
+int main() {
+    orange::http::LoopbackServer server;
+    std::uint16_t port = 0;
+    if (server.bind(0, &port) != 0)
+        return 1;
+    std::atomic_bool stop{false};
+    int result = -1;
+    std::thread worker([&] {
+        result = server.serve(
+            [](const orange::http::ParsedMessage &) {
+                queued_at = waits;
+                pending = true;
+                return orange::http::Response{
+                    200, orange::http::BodyFraming::content_length, "ok", {}, false};
+            },
+            std::chrono::seconds(5), stop);
+    });
+    const int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(port);
+    const timeval timeout{2, 0};
+    bool pass = fd >= 0 &&
+                ::setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) == 0 &&
+                ::connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0;
+    const std::string request = "GET / HTTP/1.1\r\n\r\n";
+    if (pass)
+        pass =
+            ::send(fd, request.data(), request.size(), 0) == static_cast<ssize_t>(request.size());
+    const std::string expected = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";
+    std::string received;
+    while (pass && received.size() < expected.size()) {
+        char bytes[128];
+        const auto count = ::recv(fd, bytes, sizeof(bytes), 0);
+        if (count <= 0)
+            pass = false;
+        else
+            received.append(bytes, static_cast<std::size_t>(count));
+    }
+    ::close(fd);
+    stop.store(true);
+    worker.join();
+    pass = pass && received == expected && result == 0 && observed.load() && immediate.load();
+    std::printf("KS-1: wire=%s first_send_before_next_wait=%s\n",
+                received == expected ? "Pass" : "Fail", immediate.load() ? "Pass" : "Fail");
+    return pass ? 0 : 1;
+}
